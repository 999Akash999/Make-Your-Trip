<% layout("/layouts/boilerplate") %>

<div class="profile-card">

<h2>Edit Profile</h2>

<form
action="/profile?_method=PUT"
method="POST"
enctype="multipart/form-data"
>

<div class="mb-3">
<label>Bio</label>

<textarea
name="bio"
class="form-control"
><%= user.bio %></textarea>
</div>

<div class="mb-3">
<label>Phone</label>

<input
type="text"
name="phone"
class="form-control"
value="<%= user.phone %>"
>
</div>

<div class="mb-3">
<label>City</label>

<input
type="text"
name="city"
class="form-control"
value="<%= user.city %>"
>
</div>
<div class="mb-3">

<label>
Profile Image
</label>

<input
type="file"
name="image"
class="form-control"
accept="image/*"
>

</div>
<button
class="btn btn-dark"
>
Save Changes
</button>

</form>

</div>