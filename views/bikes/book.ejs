<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/bikes.css">
<link rel="stylesheet" href="/css/transport-booking.css">

<div class="bikes-wrapper">
  <div class="mb-3">
    <a href="/bikes/<%= bike._id %>" class="text-muted text-decoration-none small">&larr; Back to bike overview</a>
  </div>

  <h2 class="fw-bold mb-4">Reserve <%= bike.bikeName %></h2>

  <form action="/bikes/<%= bike._id %>/book" method="POST" id="bikeBookingForm">
    <div class="row g-4">
      
      <!-- Left: Form inputs -->
      <div class="col-lg-7">
        <div class="card p-4 rounded-4 border">
          <h5 class="fw-bold mb-3">Trip & Pickup Location</h5>

          <div class="mb-3">
            <label class="form-label small fw-bold text-muted text-uppercase">Select Pickup Hub</label>
            <select name="pickupHub" class="form-select" required>
              <% for(let hub of bike.pickupLocations) { %>
                <option value="<%= hub.hubName %>"><%= hub.hubName %> (<%= hub.address %>)</option>
              <% } %>
            </select>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted text-uppercase">Start Date</label>
              <input type="date" name="startDate" id="startDate" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted text-uppercase">End Date</label>
              <input type="date" name="endDate" id="endDate" class="form-control" required>
            </div>
          </div>

          <h5 class="fw-bold mb-3">Rider Documentation</h5>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted">FULL NAME</label>
              <input type="text" name="driverInfo[fullName]" class="form-control form-control-sm" placeholder="As on Driving License" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted">DRIVING LICENSE NUMBER</label>
              <input type="text" name="driverInfo[drivingLicenseNumber]" class="form-control form-control-sm text-uppercase" placeholder="DL-XXXXXXXXXXXX" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted">PHONE NUMBER</label>
              <input type="tel" name="driverInfo[contactNumber]" class="form-control form-control-sm" placeholder="10-digit number" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted">EMAIL</label>
              <input type="email" name="driverInfo[email]" class="form-control form-control-sm" placeholder="name@example.com" required>
            </div>
          </div>

        </div>
      </div>

      <!-- Right: Live Bill Calculation Card -->
      <div class="col-lg-5">
        <div class="card p-4 rounded-4 border shadow-sm">
          <h5 class="fw-bold mb-3">Fare Breakdown</h5>
          
          <div class="d-flex justify-content-between py-1 small">
            <span class="text-muted">Daily Rate</span>
            <span class="fw-semibold">₹<%= bike.pricing.dailyRent %></span>
          </div>
          <div class="d-flex justify-content-between py-1 small">
            <span class="text-muted">Total Days Selected</span>
            <span class="fw-bold text-dark" id="displayDays">1 Day</span>
          </div>
          <div class="d-flex justify-content-between py-1 small">
            <span class="text-muted">Base Rent</span>
            <span class="fw-semibold" id="displayRent">₹<%= bike.pricing.dailyRent %></span>
          </div>
          <div class="d-flex justify-content-between py-1 small">
            <span class="text-muted">Refundable Deposit</span>
            <span class="fw-semibold">₹<%= bike.pricing.securityDeposit %></span>
          </div>
          <div class="d-flex justify-content-between py-1 small">
            <span class="text-muted">GST & Platform Fees (5%)</span>
            <span class="fw-semibold" id="displayTax">₹<%= Math.round(bike.pricing.dailyRent * 0.05) %></span>
          </div>

          <hr>

          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <span class="small text-muted d-block">Total Payable Now</span>
              <h3 class="fw-bold text-dark mb-0" id="displayTotal">
                ₹<%= bike.pricing.dailyRent + bike.pricing.securityDeposit + Math.round(bike.pricing.dailyRent * 0.05) %>
              </h3>
            </div>
            <span class="badge bg-success-subtle text-success">Instant Confirm</span>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3">
            Confirm & Pay
          </button>
        </div>
      </div>

    </div>
  </form>
</div>

<script>
  const dailyRate = <%= bike.pricing.dailyRent %>;
  const deposit = <%= bike.pricing.securityDeposit %>;
  const startInput = document.getElementById("startDate");
  const endInput = document.getElementById("endDate");

  // Set default dates (today to tomorrow)
  const today = new Date().toISOString().split("T")[0];
  startInput.min = today;
  startInput.value = today;

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const tomorrowStr = tomorrow.toISOString().split("T")[0];
  endInput.min = tomorrowStr;
  endInput.value = tomorrowStr;

  function calculateFare() {
    const sDate = new Date(startInput.value);
    const eDate = new Date(endInput.value);
    let diffDays = Math.ceil((eDate - sDate) / (1000 * 60 * 60 * 24));
    if (diffDays <= 0 || isNaN(diffDays)) diffDays = 1;

    const rent = diffDays * dailyRate;
    const tax = Math.round(rent * 0.05);
    const total = rent + deposit + tax;

    document.getElementById("displayDays").innerText = diffDays + (diffDays === 1 ? " Day" : " Days");
    document.getElementById("displayRent").innerText = "₹" + rent;
    document.getElementById("displayTax").innerText = "₹" + tax;
    document.getElementById("displayTotal").innerText = "₹" + total;
  }

  startInput.addEventListener("change", calculateFare);
  endInput.addEventListener("change", calculateFare);
</script>
