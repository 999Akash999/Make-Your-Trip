<% layout("/layouts/boilerplate") %>

<h1 class="mb-4">
    My Flight Bookings
</h1>

<% if(bookings.length===0){ %>

<div class="alert alert-info">
    No Bookings Yet
</div>

<% } %>

<div class="row">

<% bookings.forEach(
booking=>{
%>

<div class="col-md-4">

<div class="card shadow mb-4">

<div class="card-body">

<h4>
<%= booking.flight.airline %>
</h4>

<p>
<strong>
<%= booking.flight.source %>
</strong>

→

<strong>
<%= booking.flight.destination %>
</strong>
</p>

<p>
₹<%= booking.totalAmount %>
</p>

<p>
Status:
<span class="badge bg-success">
<%= booking.status %>
</span>
</p>
<form
action="/flights/booking/<%= booking._id %>?_method=DELETE"
method="POST"
class="mt-3"
>

<button
class="btn btn-danger w-100"
>
Cancel Booking
</button>

</form>

</div>

</div>

</div>

<% }) %>

</div>