<% layout("/layouts/boilerplate") %>

<style>
  .ticket-container {
    max-width: 820px;
    margin: 5.5rem auto 4rem;
    padding: 0 1.25rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .boarding-pass {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  }
  .pass-header {
    background: #4f46e5;
    color: #ffffff;
    padding: 1.5rem 2rem;
  }
  .barcode-strip {
    background: #0f172a;
    color: #ffffff;
    font-family: monospace;
    letter-spacing: 0.35em;
    text-align: center;
    padding: 0.5rem;
    font-size: 0.85rem;
  }
  .flight-time-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.25rem;
    text-align: center;
  }
</style>

<div class="ticket-container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/flights" class="text-muted text-decoration-none small">&larr; Back to Flights</a>
    <button onclick="window.print()" class="btn btn-sm btn-outline-dark fw-bold rounded-pill">Print Boarding Pass</button>
  </div>

  <div class="boarding-pass">
    <div class="pass-header d-flex justify-content-between align-items-center">
      <div>
        <h4 class="fw-bold mb-0">E-BOARDING PASS</h4>
        <span class="small opacity-75">MakeYourTrip Airlines Partner</span>
      </div>
      <div class="text-end">
        <span class="small opacity-75 text-uppercase">Booking Ref / PNR</span>
        <h3 class="fw-bold mb-0 text-warning"><%= booking.pnrNumber || booking.bookingCode || "MYT-FLIGHT" %></h3>
      </div>
    </div>

    <div class="barcode-strip">
      ||| |||| | ||||| || |||| |||| ||| <%= booking._id %> ||| | ||
    </div>

    <div class="p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
          <h4 class="fw-bold text-dark mb-0"><%= booking.flight ? booking.flight.airline : "Airline Service" %> - <%= booking.flight ? booking.flight.flightNumber : "FL-101" %></h4>
          <span class="badge bg-light text-dark border mt-1">Class: Economy</span>
        </div>
        <span class="badge <%= booking.status === 'Cancelled' ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> fs-6 px-3 py-2 rounded-pill"><%= booking.status %></span>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-6">
          <div class="flight-time-box">
            <span class="text-muted small fw-bold text-uppercase">Origin</span>
            <h3 class="fw-bold text-dark mt-1 mb-0"><%= booking.flight ? booking.flight.source : "Delhi" %></h3>
            <span class="small text-muted"><%= booking.flight && booking.flight.departureTime ? new Date(booking.flight.departureTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : "09:00 AM" %></span>
          </div>
        </div>
        <div class="col-6">
          <div class="flight-time-box">
            <span class="text-muted small fw-bold text-uppercase">Destination</span>
            <h3 class="fw-bold text-dark mt-1 mb-0"><%= booking.flight ? booking.flight.destination : "Mumbai" %></h3>
            <span class="small text-muted"><%= booking.flight && booking.flight.arrivalTime ? new Date(booking.flight.arrivalTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : "11:15 AM" %></span>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center pt-3 border-top">
        <div>
          <span class="text-muted small d-block">Passenger Name</span>
          <span class="fw-bold text-dark"><%= currUser ? currUser.username : "Guest Passenger" %></span>
        </div>
        <div class="text-end">
          <span class="text-muted small d-block">Total Paid</span>
          <h3 class="fw-bold text-dark mb-0">₹<%= booking.totalAmount || (booking.flight ? booking.flight.price : 5500) %></h3>
        </div>
      </div>
    </div>
  </div>
</div>
