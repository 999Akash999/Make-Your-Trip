<% layout("/layouts/boilerplate") %>

<div class="flight-page">

    <div class="flight-detail-card">

        <div class="flight-header">

            <div class="flight-airline">
                ✈ <%= flight.airline %>
            </div>

            <div class="flight-route">
                <%= flight.source %> → <%= flight.destination %>
            </div>

        </div>

        <div class="flight-info">

            <div class="flight-info-row">
                <span class="flight-label">
                    Flight Number
                </span>

                <span class="flight-value">
                    <%= flight.flightNumber %>
                </span>
            </div>

            <div class="flight-info-row">
                <span class="flight-label">
                    Departure
                </span>

                <span class="flight-value">
                    <%= flight.departureTime.toLocaleString() %>
                </span>
            </div>

            <div class="flight-info-row">
                <span class="flight-label">
                    Arrival
                </span>

                <span class="flight-value">
                    <%= flight.arrivalTime.toLocaleString() %>
                </span>
            </div>

            <div class="flight-info-row">
                <span class="flight-label">
                    Seats Available
                </span>

                <span class="flight-value">
                    <%= flight.seatsAvailable %>
                </span>
            </div>

            <div class="price-box">

                <div class="flight-label">
                    Ticket Price
                </div>

                <div class="price">
                    ₹<%= flight.price %>
                </div>

            </div>

            <% if(currUser){ %>

                <form
                    action="/flights/book/<%= flight._id %>"
                    method="POST"
                >

                    <button class="book-btn">
                        Book Flight
                    </button>

                </form>

            <% } else { %>

                <a
                    href="/login"
                    class="btn book-btn"
                >
                    Login To Book
                </a>

            <% } %>

        </div>

    </div>

</div></div>