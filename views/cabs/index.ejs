<% layout("/layouts/boilerplate") %>

<div class="cabs-page-wrapper">
  
  <!-- Header Bar -->
  <div class="cab-header-row">
    <div>
      <h1 class="page-heading">Available Cabs & Taxis</h1>
      <p class="page-subheading">Verified chauffeurs, sanitized vehicles & instant outstation bookings</p>
    </div>
    
  </div>

  <!-- Search Filter Card -->
  <div class="cab-search-card">
    <form action="/cabs" method="GET" class="cab-search-form">
      <div class="search-input-group">
        <label>CITY / DESTINATION</label>
        <div class="input-with-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <input 
            type="text" 
            name="city" 
            placeholder="e.g. Bangalore, Delhi, Mumbai" 
            value="<%= searchCity %>"
          >
        </div>
      </div>

      <div class="search-divider"></div>

      <div class="search-input-group">
        <label>VEHICLE CATEGORY</label>
        <div class="input-with-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><rect x="3" y="11" width="18" height="8" rx="2"></rect><path d="M5 11l2-5h10l2 5"></path><circle cx="7.5" cy="15.5" r="1.5"></circle><circle cx="16.5" cy="15.5" r="1.5"></circle></svg>
          <select name="vehicleType">
            <option value="">All Categories</option>
            <option value="Sedan">Sedan</option>
            <option value="SUV">SUV</option>
            <option value="Hatchback">Hatchback</option>
            <option value="Luxury">Luxury</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn-search-cab">
        <span>Search Cabs</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
    </form>
  </div>

  <!-- Listings Grid -->
  <div class="cab-grid">
    <% if (cabs.length === 0) { %>
      <div class="empty-state-box">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        <h4>No vehicles found</h4>
        <p>Try searching for a different city or category.</p>
        <a href="/cabs" class="btn-reset">Clear Filters</a>
      </div>
    <% } %>

    <% for (let cab of cabs) { %>
      <article class="cab-listing-card">
        <!-- Media Container -->
        <div class="cab-image-container">
          <a href="/cabs/<%= cab._id %>" class="image-link" tabindex="-1">
            <img 
              src="<%= cab.image.url %>" 
              alt="<%= cab.vehicleName %>"
              class="cab-card-thumb"
              loading="lazy"
            >
          </a>
          
          <button type="button" class="cab-fav-btn" aria-label="Save to favorites">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
          
          <span class="cab-type-chip"><%= cab.vehicleType %></span>
        </div>

        <!-- Meta Info -->
        <div class="cab-meta">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="cab-city-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              <%= cab.operatingCity %>
            </span>
            <span class="cab-seats-label"><%= cab.capacity.passengers %> Seats</span>
          </div>

          <h3 class="cab-name">
            <a href="/cabs/<%= cab._id %>"><%= cab.vehicleName %></a>
          </h3>

          <div class="cab-features-mini">
            <span><%= cab.hasAC ? "AC" : "Non-AC" %></span>
            <span class="dot">•</span>
            <span><%= cab.fuelType %></span>
          </div>

          <!-- Price & CTA -->
          <div class="cab-price-row">
            <div class="price-box">
              <span class="price-val">₹<%= cab.pricing.pricePerKm %></span>
              <span class="price-unit">/km</span>
            </div>
            <a href="/cabs/<%= cab._id %>" class="btn-book-pill">
              Book
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>
    <% } %>
  </div>
</div>