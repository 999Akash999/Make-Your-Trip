<% if (success && success.length) { %>
  <div  style="z-index: 10;" class="alert alert-success alert-dismissible fade show col-6 offset-3 mt-5 mb-1" role="alert">
    <%= success[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div style="z-index:10;" class="alert alert-danger alert-dismissible fade show col-6 offset-3 mt-5 mb-1" role="alert">
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>