<nav class="navbar navbar-expand-lg theme-navbar sticky-top">
  <div class="container-fluid navbar-inner">

    <!-- Brand Logo -->
    <a class="navbar-brand brand-wrap" href="/listings">
      <img src="https://i.ibb.co/xKVfsfPx/Gemini-Generated-Image-fgihffgihffgihff.png" alt="Make Your Trip Logo" class="brand-logo-img">
      <span class="brand-title">Make Your Trip</span>
    </a>

    <!-- Mobile Hamburger Toggle -->
    <button
      class="navbar-toggler custom-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collapsible Menu -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- Center Search Bar -->
      <div class="mx-auto search-container-wrap">
        <form class="nav-search-bar" role="search" action="/listings/search" method="GET">
          <i class="fa-solid fa-magnifying-glass search-leading-icon" aria-hidden="true"></i>
          <input
            class="nav-search-input"
            type="search"
            name="q"
            placeholder="Search stays, cities, destinations..."
            aria-label="Search"
          >
          <button class="nav-search-submit-btn" type="submit">
            Search
          </button>
        </form>
      </div>

      <!-- Right Navigation Actions -->
      <div class="navbar-nav ms-auto align-items-lg-center nav-actions-group">

        

        <% if (!currUser) { %>
          <a class="nav-link nav-link-text" href="/signup">
            Sign up
          </a>

          <a class="btn-nav-login nav-login-link" href="/login">Log in</a>
        <% } %>

        <% if (currUser) { %>
          <a href="/profile" class="nav-link profile-link-wrap" title="My Profile">
            <img
              src="<%= currUser.image && currUser.image.url ? currUser.image.url : '/images/labubu-404.png' %>"
              alt="<%= currUser.username %>"
              class="nav-avatar-img"
            >
          </a>

          <a class="btn-nav-logout nav-logout-link" href="/logout">Log out</a>
        <% } %>

      </div>

    </div>
  </div>
</nav>
